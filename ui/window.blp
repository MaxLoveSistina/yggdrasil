using Gtk 4.0;

template $MainWindow : Window {
  title: "Launcher";
  default-width: 700;
  default-height: 500;

  Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    Box {
      orientation: horizontal;
      spacing: 8;

      SearchEntry search_entry {
        hexpand: true;
        placeholder-text: "Поиск приложений...";
      }

      Button settings_button {
        icon-name: "open-menu-symbolic";
        width-request: 36;
        height-request: 36;

        styles ["flat"]
      }
    }

    ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      FlowBox app_grid {
        valign: start;
        max-children-per-line: 8;
        min-children-per-line: 4;
        row-spacing: 12;
        column-spacing: 12;
        homogeneous: true;
        selection-mode: none;
      }
    }
  }
}
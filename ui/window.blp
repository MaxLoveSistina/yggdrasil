using Gtk 4.0;

template $MainWindow : Window {
  title: "Yggdrasil";
  default-width: 1000;
  default-height: 700;

  Overlay {
    Picture background_picture {
      content-fit: cover;
      can-shrink: true;
      can-target: false;
    }

    [overlay]
    Box dim_overlay {
      can-target: false;

      styles ["dim-overlay"]
    }

    [overlay]
    Box {
      orientation: vertical;
      spacing: 12;
      margin-top: 16;
      margin-bottom: 16;
      margin-start: 16;
      margin-end: 16;
      hexpand: true;
      vexpand: true;

      SearchEntry search_entry {
        width-request: 320;
        halign: start;
        placeholder-text: "Search apps...";
      }

      Box categories_bar {
        orientation: horizontal;
        spacing: 6;
        halign: center;
        height-request: 40;
      }

      ScrolledWindow {
        vexpand: true;
        hexpand: true;
        hscrollbar-policy: never;

        FlowBox app_grid {
          valign: start;
          halign: center;
          margin-top: 8;
          max-children-per-line: 10;
          min-children-per-line: 5;
          row-spacing: 10;
          column-spacing: 10;
          homogeneous: true;
          selection-mode: none;
        }
      }

      Box pinned_panel {
        orientation: horizontal;
        spacing: 8;
        halign: center;
        height-request: 64;
      }
    }

    [overlay]
    Button settings_button {
      icon-name: "open-menu-symbolic";
      width-request: 36;
      height-request: 36;
      halign: end;
      valign: start;
      margin-top: 16;
      margin-end: 16;

      styles ["flat"]
    }
  }
}